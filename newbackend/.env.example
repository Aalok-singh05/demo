# ============================================================================
# NEXUS BACKEND — Environment Variables Template
# ============================================================================
# Copy this to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it contains secrets!
# ============================================================================

# --- LLM API Keys ---
# Primary: Google Gemini (free tier, fast, structured output)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback: OpenAI (if Gemini rate-limits during demo)
OPENAI_API_KEY=your_openai_api_key_here

# --- LLM Configuration ---
# Which model to use as default
LLM_MODEL=gemini-2.0-flash
# Temperature for LLM calls (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.3

# --- Database ---
# SQLite database file path (relative to newbackend/ folder)
DATABASE_URL=sqlite:///./data/nexus.db

# --- Server ---
# Host and port for the FastAPI server
HOST=0.0.0.0
PORT=8000
# Enable debug mode (auto-reload, verbose errors)
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email / SMTP (optional — mock mode used by default) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=nexus@event.local
# Set to "true" to actually send emails, "false" for mock/log mode
EMAIL_REAL_SEND=false
